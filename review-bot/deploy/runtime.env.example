CELLD_BUCKET=s3://your-private-bucket
S3_ENDPOINT=https://objects.eu-north-3.verda.storage
AWS_REGION=eu-north-3
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
CELLD_ADDR=127.0.0.1:8080
CELLD_INTERNAL_ADDR=127.0.0.1:8081
CELLD_ADVERTISE=127.0.0.1:8081
CELLD_WATCH=/data/cells
CELLD_ASSET_CACHE_DIR=/data/assets
CELLD_TRUST_FORWARDED_HEADERS=1
CELLD_MAX_REQUEST_BODY_BYTES=1048576
CELLD_MAX_RSS_MB=10000
CELLD_FETCH_TIMEOUT_S=600
CELLD_HANDLER_BUDGET_S=900
CELLD_LTX_RETENTION_SECS=86400
RUST_LOG=warn
