# uv 0.13.8 and the Bun canary of 2026-11-14 (1.4.5-canary.1+9098897a1), pinned
# by multi-arch index digest. The repo's own `bun check` and `bun fmt` exist only
# in Bun canary.
FROM ghcr.io/astral-sh/uv:0.13.8@sha256:5cc1805e2426484abca4ad46ea783bab281fdb225fd82d8ce6d66a81254bac85 AS uv
FROM docker.io/oven/bun:canary@sha256:d1d312ea67533ef99807c10b89a0259b233a1559850a1a8e590998497a600e89 AS bun

FROM docker.io/library/node:22-bookworm-slim AS worker

# This image is deliberately a general-purpose root shell for the review
# agent. The runtime itself is ephemeral; the agent may install additional
# language toolchains during a review when the preinstalled base is insufficient.
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    bash \
    build-essential \
    ca-certificates \
    cargo \
    curl \
    file \
    git \
    golang-go \
    jq \
    openjdk-17-jdk-headless \
    pkg-config \
    procps \
    python3 \
    python3-dev \
    python3-pip \
    python3-venv \
    ripgrep \
    unzip \
    xz-utils \
    zip \
  && rm -rf /var/lib/apt/lists/*

COPY --from=uv /uv /uvx /usr/local/bin/
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
RUN ln -s bun /usr/local/bin/bunx

# Debian ships Python 3.11; the scanner requires 3.13, so keep a uv-managed
# 3.13 in the image instead of downloading it on every review.
ENV UV_PYTHON_INSTALL_DIR=/opt/uv/python UV_PYTHON_BIN_DIR=/usr/local/bin
RUN uv python install 3.13

WORKDIR /
CMD ["sleep", "infinity"]

FROM docker.io/library/node:22-bookworm-slim AS manager
RUN apt-get update && apt-get install -y --no-install-recommends podman git ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY server.mjs process.mjs ./
EXPOSE 8787
CMD ["node", "server.mjs"]
