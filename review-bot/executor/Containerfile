FROM docker.io/library/node:22-bookworm-slim AS worker

# This image is deliberately a general-purpose root shell for the review
# agent. The runtime itself is ephemeral; the agent may install additional
# language toolchains during a review when the preinstalled base is insufficient.
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    bash \
    build-essential \
    ca-certificates \
    cargo \
    curl \
    git \
    golang-go \
    openjdk-17-jdk-headless \
    python3 \
    unzip \
    xz-utils \
    zip \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /
CMD ["sleep", "infinity"]

FROM docker.io/library/node:22-bookworm-slim AS manager
RUN apt-get update && apt-get install -y --no-install-recommends podman git ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY server.mjs process.mjs ./
EXPOSE 8787
CMD ["node", "server.mjs"]
