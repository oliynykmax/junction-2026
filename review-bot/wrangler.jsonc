{
  "name": "j26-review-bot",
  "main": "src/index.ts",
  "account_id": "b9065ca4c59a3d2ebb9430692a07bf2c",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "rules": [
    { "type": "Text", "globs": ["**/*.svg"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.ico", "**/*.png"], "fallthrough": true },
  ],
  "vars": {
    "REVIEW_BASE_URL": "https://review.oliinyk.dev",
    // Pinned to a commit so every review records exactly which rubric it ran.
    "REVIEW_PROMPT_URL": "https://raw.githubusercontent.com/cursor/plugins/6e3d2ea56d7d446b955eaae6ac4c8eef8bf504cf/cursor-team-kit/skills/thermo-nuclear-code-quality-review/SKILL.md",
    "MODEL_ID": "claude-sonnet-5-5",
    "THINKING_LEVEL": "medium",
  },
  "durable_objects": {
    "bindings": [{ "name": "REVIEWS", "class_name": "Review" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Review"] }],
  "routes": [
    {
      "pattern": "review.oliinyk.dev",
      "custom_domain": true,
      "zone_name": "oliinyk.dev",
    },
  ],
}
